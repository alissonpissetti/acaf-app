# Fastlane lanes para publicação automática (Android + iOS).
# Invocado pelo GitHub Actions em .github/workflows/release.yml

default_platform(:ios)

def flutter_build_args
  build_name = ENV.fetch("BUILD_NAME")
  build_number = ENV.fetch("BUILD_NUMBER")
  "--release --build-name=#{build_name} --build-number=#{build_number}"
end

platform :android do
  lane :deploy do
    sh("flutter pub get")
    sh("flutter build appbundle #{flutter_build_args}")

    upload_to_play_store(
      json_key_data: ENV.fetch("PLAY_STORE_SERVICE_ACCOUNT_JSON"),
      package_name: "com.acaf.acaf",
      track: ENV.fetch("PLAY_STORE_TRACK", "internal").strip.empty? ? "internal" : ENV.fetch("PLAY_STORE_TRACK"),
      release_status: "completed",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

platform :ios do
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
      is_key_content_base64: true,
    )

    sh(
      "flutter pub get && flutter build ipa #{flutter_build_args} " \
      "--export-options-plist=ios/ExportOptions.plist",
    )

    ipa_path = Dir["build/ios/ipa/*.ipa"].first
    UI.user_error!("IPA não encontrado após flutter build ipa") unless ipa_path

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )
  end
end
